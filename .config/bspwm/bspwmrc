pgrep -x sxhkd > /dev/null || sxhkd &


start_daemons(){
 # killall sxhkd 
  killall polybar
  pidof -q picom || picom &
  # Daemon principal: comprobar ESTE daemon (ping), no cualquier proceso eww,
  # o el de display-manager lo tapa y los `eww open` acaban creando duplicados.
  eww -c "${HOME}/.config/eww" ping >/dev/null 2>&1 || eww -c "${HOME}/.config/eww" daemon &
  # Display Control widget daemon (config propia; si ya corre, sale solo)
  eww --config "${HOME}/Documentos/Project/display-manager/widget/eww" daemon &

  # El icono de Spotify de cada barra lo abre setup_monitors.sh (sección POLYBAR).
 # pidof -q sxhkd > /dev/null || sxhkd &

  killall -q dunst
  wait 2>/dev/null
  dunst &
  wmname LG3D &
}

{ start_daemons & } 2>"${ERROR_LOG}"

