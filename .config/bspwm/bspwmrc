# Touchpad configuration: tap-to-click, natural scrolling, disable-while-typing
{ ~/.config/bspwm/scripts/touchpad/setup_touchpad.sh & } 2>"${ERROR_LOG}"

# lavender = #b4befe -> Mocha theme 
 
focused_color="#C2F6FC"

# base       = #1e1e2e


normal_color="#1e1e2e"

bspc config window_gap          10
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focused_border_color "${focused_color}"
bspc config normal_border_color "${normal_color}"
bspc config border_width 2
bspc config focus_follows_pointer true

# Al desenchufar o apagar (xrandr --off) un monitor, sus escritorios y ventanas
# pasan al que queda en vez de quedarse en un monitor fantasma inaccesible.
